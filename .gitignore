# =========================================================================
# CAREBRIDGE AI — GITIGNORE CONFIGURATION
# Protects secrets, credentials, databases, node_modules, and build outputs
# =========================================================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Environment Variables & Secret Files (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
backend/*.env
frontend/.env
frontend/*.env
env/.env
env/*.local

# Retain Example & Template Files in Git
!.env.example
!backend/.env.example
!frontend/.env.example
!env/.env.example
!env/.env.development
!env/.env.production

# SQLite Databases & WAL Journal Files
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm
database/*.sqlite-journal
database/*.db
database/*.db-wal
database/*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db

# User Uploaded Medical Documents & PDFs
backend/uploads/*
!backend/uploads/.gitkeep

# Build Bundles & Distributions
dist/
dist-ssr/
frontend/dist/
build/
out/

# Vite, Turbo, & Cache Dirs
.vite/
.vite-cache/
.cache/
.parcel-cache/

# Testing & Coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
