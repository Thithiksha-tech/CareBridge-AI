# ==============================================================================
# CAREBRIDGE AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' (or 'backend/.env') and customize with your own values
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# JWT Authentication
# Replace with a strong, random 32+ character secret string for production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=7d

# SQLite Database Storage Location (relative to backend or workspace root)
DATABASE_PATH=./database/carebridge.sqlite

# ------------------------------------------------------------------------------
# Google Gemini AI Integration
# Get your Gemini API key free at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# Email Delivery Service (Care Reminders & Doctor Notifications)
# For production Gmail:
#   1. Set EMAIL_HOST=smtp.gmail.com
#   2. Set EMAIL_PORT=465, EMAIL_SECURE=true
#   3. Use a 16-character Google App Password (not your normal Google account password)
# For development/testing:
#   Leave EMAIL_USER and EMAIL_PASS blank to automatically use test mailer (Ethereal)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CareBridge AI Care Reminders <reminders@carebridge.ai>"

# Client Frontend URL (For CORS and redirect links)
FRONTEND_URL=http://localhost:3000
