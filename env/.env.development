# Development Environment Configuration
PORT=5000
NODE_ENV=development

JWT_SECRET=carebridge_dev_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

DATABASE_PATH=./database/carebridge.sqlite

# Google Gemini AI Integration
# Set your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000

# Automated Development Test Mailer (Ethereal test accounts generated on-the-fly)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CareBridge AI Dev Reminders <dev-reminders@carebridge.ai>"

FRONTEND_URL=http://localhost:3000
