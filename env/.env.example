# ==============================================================================
# CAREBRIDGE AI — MASTER ENVIRONMENT TEMPLATE
# Copy to .env in the root or backend directory:
#   cp env/.env.example .env
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Database Path
DATABASE_PATH=./database/carebridge.sqlite

# Google Gemini AI Integration
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000

# Email Delivery Configuration (SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CareBridge AI Care Reminders <reminders@carebridge.ai>"

# Frontend Client URL
FRONTEND_URL=http://localhost:3000
