# Production Environment Configuration
PORT=5000
NODE_ENV=production

# Production Security
# Set a cryptographically secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

DATABASE_PATH=./database/carebridge.sqlite

# Google Gemini AI Integration (Production API Key)
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000

# Production SMTP Email Delivery (e.g., Gmail, SendGrid, Amazon SES)
# Example for Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your_clinical_relay@gmail.com
# EMAIL_PASS=your_16_character_app_password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CareBridge AI Clinical Recovery <noreply@carebridge.ai>"

FRONTEND_URL=https://your-domain.com
